# =====================================================================
# Variables d'environnement — à recopier dans Vercel (Settings → Environment Variables)
# Ne JAMAIS committer le fichier .env réel : il est ignoré par .gitignore.
# =====================================================================

# --- Supabase (Project Settings → API) -------------------------------
# L'URL de base, SANS /rest/v1 : le code ajoute le chemin lui-même.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase a renommé ses clés. Selon l'ancienneté du projet, vous verrez :
#   nouveau : sb_publishable_...   ancien : anon public (eyJ...)
#   nouveau : sb_secret_...        ancien : service_role (eyJ...)
# Les deux formats fonctionnent de la même façon ; seul le nom a changé.

# PUBLIQUE — peut apparaître dans le navigateur, protégée par les règles RLS
SUPABASE_ANON_KEY=sb_publishable_...

# SECRÈTE — contourne TOUTES les règles d'accès. Serveur uniquement.
# Ne jamais la mettre dans le HTML, ni dans un dépôt, ni la transmettre à qui que ce soit.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Resend (resend.com → API Keys) ----------------------------------
RESEND_API_KEY=re_...
# Expéditeur : le domaine doit être vérifié dans Resend
EMAIL_EXPEDITEUR=Socle <bonjour@votredomaine.fr>
# Votre adresse : reçoit les notifications de nouveaux projets
EMAIL_ATELIER=vous@votredomaine.fr

# --- Cloudflare Turnstile (dash.cloudflare.com → Turnstile) ----------
# Sans ces clés, l'anti-robot est désactivé : acceptable en local, jamais en production
TURNSTILE_SECRET_KEY=0x...
# Clé publique, à placer aussi dans le HTML
VITE_TURNSTILE_SITE_KEY=0x...

# --- Divers -----------------------------------------------------------
URL_SITE=https://votredomaine.fr
# Sel de hachage des IP : une chaîne aléatoire, à ne plus changer ensuite
SEL_IP=remplacez-par-une-chaine-aleatoire-longue
